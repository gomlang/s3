package s3;

use ecosystem::xml;
use std::bytes::{Bytes};
use std::net::url;

struct Node {
    name: string,
    text: string,
    children: Vec[Node],
}

impl Node {
    fn optional(self: Node, name: string) -> Result[string, Error] {
        let mut result = "";
        let mut count = 0;
        for child in self.children {
            if child.name == name {
                if !child.children.is_empty() {
                    return Result::Err(error(ErrorKind::Protocol, "nested scalar in S3 response"))
                }
                result = child.text;
                count += 1;
            }
        }
        if count > 1 {
            return Result::Err(error(ErrorKind::Protocol, "duplicate S3 response field"))
        }
        Result::Ok(result)
    }

    fn required(self: Node, name: string) -> Result[string, Error] {
        let value = self.optional(name)?;
        if value == "" {
            Result::Err(error(ErrorKind::Protocol, "missing S3 response field"))
        } else {
            Result::Ok(value)
        }
    }
}

fn parse_document(body: Bytes, limit: isize) -> Result[Node, Error] {
    if body.len() > limit {
        return Result::Err(error(ErrorKind::Limit, "S3 metadata limit exceeded"))
    }
    let limits = xml::Limits {
        max_input_bytes: limit,
        max_pending_bytes: limit,
        max_token_bytes: limit,
        max_decoded_bytes: limit,
        max_output_bytes: limit,
        max_depth: 16,
        max_attributes: 16,
        max_tokens: 20000,
    };
    let tokens = xml::read_all(body.as_slice(), limits).map_err(
        |_| error(ErrorKind::Protocol, "invalid S3 XML response"),
    )?;
    let stack: Vec[Node] = Vec::new();
    let mut root = Option::None;
    for token in tokens {
        match token {
            xml::Token::Start(element) => {
                if element.name.uri != ""
                    && element.name.uri != "http://s3.amazonaws.com/doc/2006-03-01/" {
                    return Result::Err(error(ErrorKind::Protocol, "unexpected S3 XML namespace"))
                }
                stack.push(Node { name: element.name.local, text: "", children: Vec::new() });
            },
            xml::Token::Text(text) | xml::Token::CData(text) => {
                if let Some(node) = stack.pop() {
                    stack.push(Node { text: node.text + text, ..node });
                }
            },
            xml::Token::End(_) => {
                let node = stack.pop().ok_or(error(ErrorKind::Protocol, "unbalanced S3 XML"))?;
                if let Some(parent) = stack.pop() {
                    parent.children.push(node);
                    stack.push(parent);
                } else {
                    root = Option::Some(node);
                }
            },
            _ => (),
        }
    }
    root.ok_or(error(ErrorKind::Protocol, "missing S3 XML root"))
}

fn parse_unsigned(value: string) -> Result[u64, Error] {
    if value == "" {
        return Result::Err(error(ErrorKind::Protocol, "invalid S3 numeric value"))
    }
    let mut result: u64 = 0;
    for byte in value.to_bytes() {
        if byte < b'0' || byte > b'9' {
            return Result::Err(error(ErrorKind::Protocol, "invalid S3 numeric value"))
        }
        let digit = (byte - b'0').to_u64();
        if result > (18446744073709551615 - digit) / 10 {
            return Result::Err(error(ErrorKind::Protocol, "S3 numeric overflow"))
        }
        result = result * 10 + digit;
    }
    Result::Ok(result)
}

fn decode_key(value: string, encoded: bool) -> Result[string, Error] {
    if !encoded {
        return Result::Ok(value)
    }
    let bytes = url::path_unescape(value, 16384).map_err(
        |_| error(ErrorKind::Protocol, "invalid encoded S3 key"),
    )?;
    let (valid, text) = string_from_utf8(bytes.to_vec());
    if valid {
        Result::Ok(text)
    } else {
        Result::Err(error(ErrorKind::Protocol, "invalid UTF-8 S3 key"))
    }
}

fn parse_list(body: Bytes, limit: isize) -> Result[ListPage, Error] {
    let root = parse_document(body, limit)?;
    if root.name != "ListBucketResult" {
        return Result::Err(error(ErrorKind::Protocol, "unexpected S3 list response"))
    }
    let encoding = root.optional("EncodingType")?;
    if encoding != "" && encoding != "url" {
        return Result::Err(error(ErrorKind::Protocol, "unknown S3 list encoding"))
    }
    let encoded = encoding == "url";
    let objects = Vec::new();
    let common_prefixes = Vec::new();
    for node in root.children {
        if node.name == "Contents" {
            objects.push(
                ObjectInfo {
                    key: decode_key(node.required("Key")?, encoded)?,
                    size: parse_unsigned(node.required("Size")?)?,
                    etag: node.optional("ETag")?,
                    last_modified: node.optional("LastModified")?,
                },
            );
        } else if node.name == "CommonPrefixes" {
            common_prefixes.push(decode_key(node.required("Prefix")?, encoded)?);
        }
    }
    let truncated = root.required("IsTruncated")?;
    let next_token = if truncated == "true" {
        let token = root.required("NextContinuationToken")?;
        if token.byte_len() > 16384 {
            return Result::Err(error(ErrorKind::Protocol, "S3 continuation token exceeds limit"))
        }
        Option::Some(token)
    } else if truncated == "false" {
        Option::None
    } else {
        return Result::Err(error(ErrorKind::Protocol, "invalid S3 truncation flag"))
    };
    Result::Ok(ListPage { objects, common_prefixes, next_token })
}

fn safe_code(code: string) -> string {
    match code {
        "AccessDenied" | "AccountProblem" | "AuthorizationHeaderMalformed" | "BadDigest" | "BucketAlreadyExists" | "BucketAlreadyOwnedByYou" | "BucketNotEmpty" | "CredentialsNotSupported" | "EntityTooLarge" | "EntityTooSmall" | "ExpiredToken" | "IncorrectEndpoint" | "InternalError" | "InvalidAccessKeyId" | "InvalidArgument" | "InvalidBucketName" | "InvalidDigest" | "InvalidPart" | "InvalidPartOrder" | "InvalidRange" | "InvalidRequest" | "InvalidSecurity" | "InvalidToken" | "MalformedXML" | "MethodNotAllowed" | "MissingContentLength" | "NoSuchBucket" | "NoSuchKey" | "NoSuchUpload" | "NoSuchVersion" | "NotImplemented" | "PermanentRedirect" | "PreconditionFailed" | "RequestTimeout" | "RequestTimeTooSkewed" | "ServiceUnavailable" | "SignatureDoesNotMatch" | "SlowDown" | "TemporaryRedirect" | "TokenRefreshRequired" => code,
        _ => "UnknownServiceError",
    }
}
